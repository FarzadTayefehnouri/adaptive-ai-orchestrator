# Adaptive AI Orchestrator Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=UTC

MAX_PARALLEL_AGENTS=5
DEFAULT_EXECUTION_TIMEOUT_SECONDS=120
STRICT_VALIDATION_ENABLED=true

# Storage & Caching
REDIS_URL=redis://localhost:6379/0
