VECTOR_DB_URL=http://localhost:6333

# Provider Keys
GEMINI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
